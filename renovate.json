{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "group:monorepos",
    "group:recommended"
  ],
  "schedule": ["before 5am on monday"],
  "timezone": "America/Chicago",
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker images in workflow shell commands",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["docker run[^\\n]*(?<depName>[a-z0-9./-]+):(?<currentValue>[a-z0-9.-]+)\\s"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge Docker image updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
